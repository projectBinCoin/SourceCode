# Supabase (Dashboard → Settings → API)
# Browser-safe anon/public key:
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Project URL:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# SERVICE ROLE secret — server-side only, NEVER expose to the browser, NEVER commit:
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Maps JavaScript API key
# Required for real maps. Without this key the app shows a placeholder grid instead of Google Maps.
# Get a key at https://developers.google.com/maps/documentation/javascript/get-api-key
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
